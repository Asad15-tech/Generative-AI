# Import os to access environment variables
import os

# Load environment variables from the .env file
from dotenv import load_dotenv

# Import ChatAnthropic from LangChain's Anthropic integration
from langchain_anthropic import ChatAnthropic


# Load variables from the .env file
load_dotenv()

# Create a ChatAnthropic model instance
# The API key is automatically read from ANTHROPIC_API_KEY
llm = ChatAnthropic(
    model="claude-3-5-sonnet-latest",
    temperature=0.7
)

# Send a prompt to the Claude model
response = llm.invoke(
    "Explain Artificial Intelligence in simple words."
)

# Print only the model's text response
print(response.content)